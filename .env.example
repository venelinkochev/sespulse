# Postgres
DATABASE_URL=postgres://ses:ses@db:5432/ses

# AWS credentials (or use an IAM role if running on AWS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SQS queue that receives SES notifications via SNS
SES_EVENTS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/ses-events

# Optional: SES outbound price per 1,000 recipients in USD (default: 0.10)
# Adjust if you're on a custom rate, in a non-standard region, or want to
# add a rough buffer for attachment-data charges.
SES_PRICE_PER_1000=0.10

# Optional: login credentials for the dashboard. If both are set, the
# dashboard requires sign-in (form-based, with a 7-day session cookie).
# If either is empty, auth is disabled entirely.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Optional: HMAC secret used to sign the session cookie. Falls back to
# DASHBOARD_PASSWORD if unset. Set this to a long random string for production.
SESSION_SECRET=

# Optional: how often the Overview and Domains pages refetch, in seconds.
# Default is 60. Set to 0 to disable auto-refresh entirely. The Email Logs
# pages never auto-refresh, regardless of this value.
DASHBOARD_REFRESH_SECONDS=60
